{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grafica-data.schema.json",
  "title": "GraficaData",
  "description": "temas/<slug>/data/<id>.json. Refinamientos no expresables en JSON Schema (se comprueban con Zod / pnpm validate): cada serie tiene tantos valores como labels; claves de series según tipo: serie_temporal = todos los ids de benchmarks; solo_espana = solo espana; por_ccaa = espana + códigos ISO 3166-2:ES; cada serie tiene al menos una fuente y cada fuente.serie es una serie existente; dispersion: códigos de punto únicos, cada uno un país de paises cuyo grupos incluye universo o el codigo_iso de un agregado de benchmarks; está ESP; fuentes con serie eje_x y eje_y; el nombre del fichero coincide con id.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "tipo": {
          "type": "string",
          "enum": [
            "serie_temporal",
            "por_ccaa",
            "solo_espana"
          ]
        },
        "unidad": {
          "type": "string"
        },
        "referencia": {
          "type": "number"
        },
        "desglose": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "categorias": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "composicion": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "proyeccion": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "desde": {
                "type": "string"
              },
              "edicion": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "desde",
              "edicion"
            ],
            "additionalProperties": false
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "fuentes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "serie": {
                "type": "string"
              },
              "organismo": {
                "type": "string"
              },
              "dataset_codigo": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "fecha_consulta": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            },
            "required": [
              "serie",
              "organismo",
              "dataset_codigo",
              "url",
              "fecha_consulta"
            ],
            "additionalProperties": false
          }
        },
        "notas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ccaa": {
          "type": "object",
          "properties": {
            "unidad": {
              "type": "string"
            },
            "referencia": {
              "type": "number"
            },
            "labels": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "series": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            },
            "fuentes": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "serie": {
                    "type": "string"
                  },
                  "organismo": {
                    "type": "string"
                  },
                  "dataset_codigo": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "fecha_consulta": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  }
                },
                "required": [
                  "serie",
                  "organismo",
                  "dataset_codigo",
                  "url",
                  "fecha_consulta"
                ],
                "additionalProperties": false
              }
            },
            "notas": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "unidad",
            "labels",
            "series",
            "fuentes",
            "notas"
          ],
          "additionalProperties": false
        },
        "generado_por": {
          "type": "string"
        },
        "generado_en": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "datos_actualizados_en": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        }
      },
      "required": [
        "id",
        "tipo",
        "unidad",
        "labels",
        "series",
        "fuentes",
        "notas",
        "generado_por",
        "generado_en",
        "datos_actualizados_en"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "tipo": {
          "type": "string",
          "const": "dispersion"
        },
        "universo": {
          "type": "string",
          "enum": [
            "ocde",
            "ue27"
          ]
        },
        "eje_x": {
          "type": "object",
          "properties": {
            "titulo": {
              "type": "string"
            },
            "unidad": {
              "type": "string"
            },
            "periodo": {
              "type": "string"
            }
          },
          "required": [
            "titulo",
            "unidad",
            "periodo"
          ],
          "additionalProperties": false
        },
        "eje_y": {
          "type": "object",
          "properties": {
            "titulo": {
              "type": "string"
            },
            "unidad": {
              "type": "string"
            },
            "periodo": {
              "type": "string"
            }
          },
          "required": [
            "titulo",
            "unidad",
            "periodo"
          ],
          "additionalProperties": false
        },
        "puntos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "codigo": {
                "type": "string"
              },
              "anio": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "codigo",
              "anio",
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "fuentes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "serie": {
                "type": "string"
              },
              "organismo": {
                "type": "string"
              },
              "dataset_codigo": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "fecha_consulta": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            },
            "required": [
              "serie",
              "organismo",
              "dataset_codigo",
              "url",
              "fecha_consulta"
            ],
            "additionalProperties": false
          }
        },
        "notas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generado_por": {
          "type": "string"
        },
        "generado_en": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "datos_actualizados_en": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        }
      },
      "required": [
        "id",
        "tipo",
        "universo",
        "eje_x",
        "eje_y",
        "puntos",
        "fuentes",
        "notas",
        "generado_por",
        "generado_en",
        "datos_actualizados_en"
      ],
      "additionalProperties": false
    }
  ]
}
